# Python
__pycache__/
*.pyc
.venv/

# yfinance runtime cache (tz lookups + Yahoo consent cookies).
# Regenerable; cookies.db must never be committed.
output/_yf_tz_cache/

# Large generated CSVs — parquet equivalents hold the same data at ~1/20th the size.
# Re-generate any time with:  .venv/bin/python pull_daily.py  (or pull_returns.py)
output/daily_returns_by_ticker.csv
output/daily_prices.csv

# Risk-parity search: large per-combination TRAIN / combinations result tables.
# Regenerable; keep the small summary CSVs + report.md tracked (see docs/).
# Re-run driver logs: per-round stdout, regenerable and noisy in diffs.
output/_rerun_logs/

output/**/train_results.csv
output/**/train_results_all_folds.csv
output/**/combinations_results.csv
output/**/combinations_results_digital.csv

# Internal session-continuity working state — not part of the public repo.
handoff.md
